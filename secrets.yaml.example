# Copy to secrets.yaml and fill in. Dummy values are fine for `esphome config`
# and `esphome compile`; only flashing and joining the network need real ones.
#
# Under the Home Assistant add-on these live in /config/esphome/secrets.yaml
# instead, and this file is only used for local Docker builds.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Generate a real one with: openssl rand -base64 32
# This placeholder is valid base64 so `esphome config` runs, but it is NOT a key.
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

ota_password: "your-ota-password"
